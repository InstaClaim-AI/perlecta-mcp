  "codes": {
    "PDF_RENDU_INVISIBLE": {
      "gravite": "majeure",
      "explication": "Texte place en mode de rendu invisible : il est present dans le fichier et extractible, mais n'est ni dessine ni imprime."
    },
    "PDF_COULEUR_FOND": {
      "gravite": "majeure",
      "explication": "Texte dont la couleur est indiscernable du fond effectif sous les glyphes."
    },
    "PDF_TAILLE_NULLE": {
      "gravite": "majeure",
      "explication": "Texte dont la taille de police est nulle ou inferieure au seuil de lisibilite."
    },
    "PDF_HORS_PAGE": {
      "gravite": "majeure",
      "explication": "Texte dont la position tombe hors de la zone de rognage ou de la zone support de la page."
    },
    "PDF_CALQUE_MASQUE": {
      "gravite": "majeure",
      "explication": "Texte place dans un groupe de contenu optionnel desactive par defaut."
    },
    "PDF_OCCULTATION": {
      "gravite": "majeure",
      "explication": "Texte recouvert par une image ou un rectangle opaque selon l'ordre de trace."
    },
    "PDF_ACTION_AUTOMATIQUE": {
      "gravite": "majeure",
      "explication": "Le document porte une action qui ne demande pas l'accord de son lecteur : declenchement a l'ouverture ou au changement de page, script embarque, lancement de programme, envoi de formulaire ou fichier joint."
    },
    "PDF_LIEN_CLIQUABLE": {
      "gravite": "mineure",
      "explication": "Le document porte un lien que le lecteur doit cliquer pour l'activer. C'est courant dans un document ordinaire ; la cible est rapportee a titre d'inventaire des sorties possibles."
    },
    "PDF_COUCHE_NUMERISEE": {
      "gravite": "mineure",
      "explication": "La page porte une couche de texte invisible sous une image de page entiere. C'est la forme normale d'un document numerise avec reconnaissance optique, et le texte est rapporte sans etre tenu pour une dissimulation. Seule la comparaison au rendu peut verifier qu'il dit bien ce que l'image montre."
    },
    "PDF_DIVERGENCE_RENDU": {
      "gravite": "majeure",
      "explication": "La couche texte du document diverge du texte obtenu par reconnaissance optique de son rendu."
    },
    "CAR_INVISIBLES": {
      "gravite": "mineure",
      "explication": "Presence de caracteres de largeur nulle, de controles bidirectionnels ou de selecteurs de variante."
    },
    "META_INSTRUCTION": {
      "gravite": "mineure",
      "explication": "Une metadonnee du document prend une forme imperative ou s'adresse a un lecteur automatique."
    },
    "HOMOGLYPHES": {
      "gravite": "mineure",
      "explication": "Melange de systemes d'ecriture a l'interieur d'un meme mot."
    },
    "DOCX_TEXTE_MASQUE": {
      "gravite": "majeure",
      "explication": "Texte portant la propriete de masquage, invisible a l'affichage et a l'impression."
    },
    "EML_CONTENU_MASQUE": {
      "gravite": "majeure",
      "explication": "Partie HTML contenant du texte rendu invisible par une regle de style."
    }
  },
